OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=IndoSync/0.1.0

# Optional durable synchronization storage (does not enable synchronization by itself).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Staging-only synchronization. Leave unset/false in production.
INDOSYNC_CALIBRATED_SYNCHRONIZATION=false
INDOSYNC_CALIBRATED_TARGET=
INDOSYNC_RUNTIME_ENV=
INDOSYNC_SYNCHRONIZATION_NAMESPACE=
INDOSYNC_REDIS_CREDENTIAL_ENV=
INDOSYNC_EVIDENCE_ENGINE_COMMAND=
INDOSYNC_EVIDENCE_ENGINE_ARGS=
# Optional. Empty = allow any public HTTP(S) host (TorBox/debrid). Set only to restrict hosts.
INDOSYNC_ALLOWED_MEDIA_HOSTS=
